[Unit]
Description=Remove stale agent scratch, pnpm store, pytest dirs, and leaked run dirs from /tmp
Documentation=file://%h/projects/agent-config/linux/cleanup/README.md

[Service]
Type=oneshot
ExecStart=%h/projects/agent-config/linux/cleanup/tmp-janitor.py --max-age 24 --apply
Nice=10
IOSchedulingClass=idle
